# Copy to .env and fill in.

# Google Places API (New) key. Keep it here on the server, never in the mobile app.
GOOGLE_PLACES_API_KEY=

# Named LLM keys: PALATE_KEY_<NAME>=<provider>:<secret>
# The name becomes lowercase with dashes (PALATE_KEY_ANTHROPIC_MAIN -> "anthropic-main").
# Access codes point at these names; see `python -m palate.admin --help`.
PALATE_KEY_ANTHROPIC_MAIN=anthropic:sk-ant-...
PALATE_KEY_ANTHROPIC_DEV=anthropic:sk-ant-...

# SQLite database file
PALATE_DB_PATH=palate.db
